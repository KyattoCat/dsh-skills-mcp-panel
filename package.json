{
  "name": "dsh-skills-mcp-panel",
  "version": "0.2.0",
  "description": "Skills & MCP panel for the DeepSeek Harness Web GUI: list, search, inspect and hot-toggle skills and MCP servers from Settings.",
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "skills",
    "mcp"
  ],
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "README.zh.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/KyattoCat/dsh-skills-mcp-panel.git"
  },
  "author": "kyattocat",
  "homepage": "https://github.com/KyattoCat/dsh-skills-mcp-panel#readme",
  "bugs": {
    "url": "https://github.com/KyattoCat/dsh-skills-mcp-panel/issues"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "engines": {
    "node": ">=22.19"
  },
  "license": "MIT"
}
